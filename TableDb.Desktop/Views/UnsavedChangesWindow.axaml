<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TableDb.Desktop.Views.UnsavedChangesWindow"
        Title="Незбережені зміни"
        Width="480" SizeToContent="Height" WindowStartupLocation="CenterOwner" CanResize="False">
    <Border Classes="card" Margin="16">
        <StackPanel Spacing="16">
            <TextBlock Text="У базі є незбережені зміни. Зберегти їх перед продовженням?" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Classes="destructive" Content="Не зберігати" Click="OnDiscard" />
                <Button Classes="secondary" Content="Скасувати" MinWidth="90" Click="OnCancel" IsCancel="True" />
                <Button Classes="primary" Content="Зберегти" MinWidth="90" Click="OnSave" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
