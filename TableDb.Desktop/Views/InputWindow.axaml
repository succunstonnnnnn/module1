<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TableDb.Desktop.Views.InputWindow"
        Width="420" SizeToContent="Height" WindowStartupLocation="CenterOwner" CanResize="False">
    <Border Classes="card" Margin="16">
        <StackPanel Spacing="8">
            <TextBlock x:Name="PromptText" Classes="label" />
            <TextBox x:Name="ValueBox" />
            <TextBlock x:Name="ErrorText" Classes="error" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                <Button x:Name="OkButton" Classes="primary" Content="OK" MinWidth="80" Click="OnOk" IsDefault="True" />
                <Button Classes="secondary" Content="Скасувати" MinWidth="80" Click="OnCancel" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
