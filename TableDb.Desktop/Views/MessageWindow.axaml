<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TableDb.Desktop.Views.MessageWindow"
        Width="440" SizeToContent="Height" WindowStartupLocation="CenterOwner" CanResize="False">
    <Border Classes="card" Margin="16">
        <StackPanel Spacing="16">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
            <Button Classes="primary" Content="OK" HorizontalAlignment="Right" MinWidth="80" Click="OnOk" IsDefault="True" />
        </StackPanel>
    </Border>
</Window>
