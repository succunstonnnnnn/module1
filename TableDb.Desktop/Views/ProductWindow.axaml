<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TableDb.Desktop.Views.ProductWindow"
        Title="Прямий добуток таблиць"
        Width="460" SizeToContent="Height" WindowStartupLocation="CenterOwner" CanResize="False">
    <Border Classes="card" Margin="16">
        <StackPanel Spacing="4">
            <TextBlock Text="Таблиця A" Classes="label" />
            <ComboBox x:Name="TableABox" HorizontalAlignment="Stretch" />
            <TextBlock Text="Таблиця B" Classes="label" Margin="0,12,0,0" />
            <ComboBox x:Name="TableBBox" HorizontalAlignment="Stretch" />
            <TextBlock Text="Назва таблиці-результату" Classes="label" Margin="0,12,0,0" />
            <TextBox x:Name="ResultNameBox" />
            <TextBlock x:Name="ErrorText" Classes="error" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
                <Button Classes="secondary" Content="Скасувати" MinWidth="90" Click="OnCancel" IsCancel="True" />
                <Button x:Name="OkButton" Classes="primary" Content="Виконати" MinWidth="90" Click="OnOk" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
