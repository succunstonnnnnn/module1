<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TableDb.Desktop.Views.CreateTableWindow"
        x:Name="Win"
        Title="Створення таблиці"
        Width="560" Height="520" WindowStartupLocation="CenterOwner">
    <Border Classes="card" Margin="16">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
                <TextBlock Text="Назва таблиці" Classes="label" />
                <TextBox x:Name="TableNameBox" />
                <TextBlock Text="Колонки" Classes="label" Margin="0,12,0,0" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
                <TextBlock x:Name="ErrorText" Classes="error" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="Додати колонку" Click="OnAddColumn" />
                    <Button Classes="secondary" Content="Скасувати" MinWidth="90" Click="OnCancel" IsCancel="True" />
                    <Button x:Name="OkButton" Classes="primary" Content="Створити" MinWidth="90" Click="OnCreate" IsDefault="True" />
                </StackPanel>
            </StackPanel>

            <ScrollViewer>
                <ItemsControl x:Name="ColumnsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,150,Auto" Margin="0,0,0,8">
                                <TextBox Grid.Column="0" Text="{Binding Name}" Watermark="Назва колонки" Margin="0,0,8,0" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding #Win.TypeNames}"
                                          SelectedItem="{Binding TypeName}" HorizontalAlignment="Stretch" Margin="0,0,8,0" />
                                <Button Grid.Column="2" Content="✕" Click="OnRemoveColumn" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
